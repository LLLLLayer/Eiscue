    },
    "connection.identityRemoved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing identity saved on this device was removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除本机保存的配对身份。"
          }
        }
      }
    },
    "connection.identitySaved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing identity saved securely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对身份已安全保存。"
          }
        }
      }
    },
    "connection.localCancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting the local connection was canceled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地连接启动已取消。"
          }
        }
      }
    },
    "connection.localReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local connection is active. Connect the device once its pairing identity is ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地连接已开启。配对身份准备就绪后即可连接设备。"
          }
        }
      }
    },
    "connection.localStopping": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local connection is closing. Device tasks have stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地连接正在关闭，设备任务已停止。"
          }
        }
      }
    },
    "connection.openPairingSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Settings → Privacy & Security → Developer Mode, select Eiscue in the pairing entry, and follow the system instructions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请前往「设置 → 隐私与安全性 → 开发者模式」，在配对入口中选择 Eiscue，并按系统提示完成配对。"
          }
        }
      }
    },
    "connection.pairingComplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing is complete. You can now connect your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对完成，可以连接设备了。"
          }
        }
      }
    },
    "connection.pairingSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for system pairing confirmation"
          }
