    "run.preparation_interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The starting conditions changed and this message has not been submitted. Return to the app and check the connection before resuming, or end this task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动条件已变化，本条消息尚未提交。请返回前台并检查连接后继续，或结束本次任务。"
          }
        }
      }
    },
    "run.unknown_delivery": {
      "extractionState": "manual",
