{
  "sourceLanguage": "en",
  "strings": {
    "speech.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to talk, or hold and release."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击说话，或按住说完后松开。"
          }
        }
      }
    },
    "speech.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入"
          }
        }
      }
    },
    "speech.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop voice input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止语音输入"
          }
        }
      }
    },
    "speech.permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for permission…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待授权…"
          }
        }
      }
    },
    "speech.preparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing voice input…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备语音输入…"
          }
        }
      }
    },
    "speech.listening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在听…"
          }
        }
      }
    },
    "speech.recordingFeedback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The waveform follows your microphone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "波形随麦克风声音变化。"
          }
        }
      }
    },
    "speech.finishing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribing…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在转成文字…"
          }
        }
      }
    },
    "speech.error.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow speech recognition for Eiscue in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 Eiscue 使用语音识别。"
          }
        }
      }
    },
    "speech.error.microphonePermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Eiscue to use the microphone in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 Eiscue 使用麦克风。"
          }
        }
      }
    },
    "speech.error.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is restricted. Type your message instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别受限，请改用文字输入。"
          }
        }
      }
    },
    "speech.error.locale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device or language doesn't support on-device speech recognition. Type your message instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前设备或语言不支持本机语音识别，请改用文字输入。"
          }
        }
      }
    },
    "speech.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device speech recognition is unavailable. Try again later or type your message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机语音识别暂时不可用，请稍后重试或输入文字。"
          }
        }
      }
    },
    "speech.error.microphoneUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't start voice input. The microphone is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动语音输入，麦克风暂不可用"
          }
        }
      }
    },
    "speech.error.noSpeech": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech recognized. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有识别到语音，请重试。"
          }
        }
      }
    },
    "speech.holdToTalk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to talk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话"
          }
        }
      }
    },
    "speech.slideToCancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to finish · Slide up to cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开结束 · 上滑取消"
          }
        }
      }
    },
    "speech.releaseToCancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开取消"
          }
        }
      }
    },
    "speech.holdHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to start or finish. You can also hold to talk and slide up to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击开始或结束，也可按住说话，上滑取消。"
          }
        }
      }
    },
    "speech.keyboardMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to keyboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换键盘输入"
          }
        }
      }
    },
    "speech.voiceMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to voice input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换语音输入"
          }
        }
      }
    },
    "speech.tapToTalk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to talk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击说话"
          }
        }
      }
    },
    "speech.tapToFinish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish dictation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束录音"
          }
        }
      }
    },
    "speech.releaseToFinish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to finish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开结束"
          }
        }
      }
    },
    "speech.error.remoteControl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't start voice input during device control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备控制期间无法启动语音输入"
          }
        }
      }
    },
    "speech.devicePreparationBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the current task before using voice input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先结束当前任务，再使用语音输入。"
          }
        }
      }
    },
    "speech.deviceReconnectFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reconnect device control. Reconnect from the device page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备控制未能恢复，请到设备页重新连接。"
          }
        }
      }
    },
    "speech.deviceReleaseFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t pause device control. Try disconnecting from the device page before using voice input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法暂停设备控制，请在设备页断开后再使用语音输入。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
