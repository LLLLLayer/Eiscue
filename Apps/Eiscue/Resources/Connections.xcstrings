    "connectionRepair.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnects Eiscue control while keeping pairing, VPN and conversations. Briefly checks microphone input without saving audio. No set phrase is needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开 Eiscue 的设备控制，保留配对、VPN 和对话。短暂检查麦克风输入，不保存录音；无需说固定语句。"
          }
        }
      }
    },
