{
  "sourceLanguage": "en",
  "strings": {
    "tunnel.status.unconfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not configured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置"
          }
        }
      }
    },
    "tunnel.error.simulator_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN needs an iPhone or iPad. It is unavailable in Simulator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 需要 iPhone 或 iPad 真机，模拟器不支持。"
          }
        }
      }
    },
    "tunnel.error.missing_bundle_id": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App ID is missing. The developer needs to fix the App configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 App 标识，请开发者检查 App 配置。"
          }
        }
      }
    },
    "tunnel.error.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN is busy. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 正忙，请稍后重试。"
          }
        }
      }
    },
    "tunnel.error.duplicate_configurations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple Eiscue VPN configurations found. Keep one in Settings → VPN, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现多个 Eiscue VPN 配置。请在「设置 → VPN」中保留一个，再重试。"
          }
        }
      }
    },
    "tunnel.error.connection_timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN timed out. A stop was requested; check its status before reconnecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 连接超时，已请求停止。请确认 VPN 状态后重新连接。"
          }
        }
      }
    },
    "tunnel.error.disconnected_during_start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN disconnected during setup. Try connecting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 在连接过程中断开，请重新连接。"
          }
        }
      }
    },
    "tunnel.error.disconnection_timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnection is not confirmed. Check the VPN status in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认是否断开。请在系统设置中查看 VPN 状态。"
          }
        }
      }
    },
    "tunnel.status.simulator_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN unavailable in Simulator"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器不支持本地 VPN"
          }
        }
      }
    },
    "tunnel.error.unowned_reloaded_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This VPN configuration is not Eiscue’s. Check it in Settings → VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 VPN 配置不属于 Eiscue，请在「设置 → VPN」中检查。"
          }
        }
      }
    },
    "tunnel.error.unowned_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This VPN configuration is not Eiscue’s. The operation stopped; check Settings → VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 VPN 配置不属于 Eiscue，已停止操作。请在「设置 → VPN」中检查。"
          }
        }
      }
    },
    "tunnel.configuration.display_name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiscue Local VPN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiscue 本地 VPN"
          }
        }
      }
    },
    "tunnel.status.connected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 已连接"
          }
        }
      }
    },
    "tunnel.status.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting local VPN…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接本地 VPN…"
          }
        }
      }
    },
    "tunnel.status.reasserting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnecting local VPN…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新连接本地 VPN…"
          }
        }
      }
    },
    "tunnel.status.disconnecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting local VPN…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在断开本地 VPN…"
          }
        }
      }
    },
    "tunnel.status.stopping": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping local VPN…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在停止本地 VPN…"
          }
        }
      }
    },
    "tunnel.status.preparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing local VPN…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备本地 VPN…"
          }
        }
      }
    },
    "tunnel.status.awaiting_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for VPN setup…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待系统完成 VPN 配置…"
          }
        }
      }
    },
    "tunnel.status.disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN disconnected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 未连接"
          }
        }
      }
    },
    "tunnel.status.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN status unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 状态未知"
          }
        }
      }
    },
    "tunnel.error.authorization_cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization cancelled. Local VPN was not started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权已取消，本地 VPN 未启动。"
          }
        }
      }
    },
    "tunnel.error.permission_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN permission was denied. Check Settings → VPN; if it still fails, ask the developer to check App signing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 授权被拒绝。请检查系统 VPN 设置；仍失败时，请开发者检查 App 签名权限。"
          }
        }
      }
    },
    "tunnel.error.invalid_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN configuration is invalid. The developer needs to check the App and VPN extension setup and signing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 配置无效，请开发者检查 App 和 VPN 扩展的配置及签名。"
          }
        }
      }
    },
    "tunnel.error.disabled_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN was disabled. Start it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 已停用，请重新开启。"
          }
        }
      }
    },
    "tunnel.error.stale_configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN settings changed. Try connecting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 配置已变化，请重新连接。"
          }
        }
      }
    },
    "tunnel.error.preferences_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN settings could not be saved or read. Check VPN permission; if it still fails, ask the developer to check App signing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读写 VPN 配置。请检查 VPN 授权；仍失败时，请开发者检查 App 签名权限。"
          }
        }
      }
    },
    "notifications.authorization.unchecked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission not checked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检查通知权限"
          }
        }
      }
    },
    "notifications.error.permission_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. You can enable them in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知未开启，可在系统设置中允许。"
          }
        }
      }
    },
    "notifications.error.authorization_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not request notification permission. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法请求通知权限，请稍后重试。"
          }
        }
      }
    },
    "notifications.task.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiscue task update"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiscue 任务进展"
          }
        }
      }
    },
    "notifications.error.submission_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification could not be sent. Open Eiscue to view the task history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知发送失败，请在 Eiscue 中查看任务记录。"
          }
        }
      }
    },
    "notifications.task.completed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This turn has ended. Open Eiscue to view the result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮处理已结束。打开 Eiscue 查看结果。"
          }
        }
      },
      "comment": "This means only that the model turn ended; it does not claim the requested device task was verified or completed."
    },
    "notifications.task.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task interrupted. Open Eiscue to view its progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已中断。打开 Eiscue 查看进展。"
          }
        }
      }
    },
    "notifications.task.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task failed. Open Eiscue to see what happened."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务运行失败。打开 Eiscue 查看原因。"
          }
        }
      }
    },
    "notifications.authorization.not_determined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission not requested"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未请求通知权限"
          }
        }
      }
    },
    "notifications.authorization.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知未开启"
          }
        }
      }
    },
    "notifications.authorization.authorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许通知"
          }
        }
      }
    },
    "notifications.authorization.provisional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet notifications only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅允许静默通知"
          }
        }
      }
    },
    "notifications.authorization.ephemeral": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications temporarily allowed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时允许通知"
          }
        }
      }
    },
    "notifications.authorization.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission unknown"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知权限未知"
          }
        }
      }
    },
    "tunnel.error.operation_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN failed: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 操作失败：%@"
          }
        }
      },
      "comment": "%@ is the localized error message provided by the operating system."
    },
    "notifications.task.paused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task paused. Open Eiscue to review and continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已暂停。打开 Eiscue 查看进展并继续。"
          }
        }
      }
    },
    "device.aiControl.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow AI to operate device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 AI 操作设备"
          }
        }
      }
    },
    "device.aiControl.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI can operate the device when connected and ready. Turn off for chat only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备就绪后，AI 可按你的要求操作。关闭后仅对话。"
          }
        }
      }
    },
    "device.aiControl.finishTask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the current task before changing this setting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先结束当前任务，再修改此设置。"
          }
        }
      }
    },
    "device.connection.disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开"
          }
        }
      }
    },
    "device.connection.vpnUsage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the VPN connection. Other VPNs cannot stay active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占用系统 VPN 通道，不能同时使用其他 VPN。"
          }
        }
      }
    },
    "device.connection.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection help"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接帮助"
          }
        }
      }
    },
    "device.connection.options": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection options"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接选项"
          }
        }
      }
    },
    "device.connection.selected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选用"
          }
        }
      }
    },
    "device.connection.bluetoothTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32-C3 / S3 input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32-C3 / S3 键鼠"
          }
        }
      }
    },
    "device.connection.usbTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32-S3 USB network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32-S3 USB 网卡"
          }
        }
      }
    },
    "device.connection.wifiTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32-C3 Wi-Fi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32-C3 Wi-Fi"
          }
        }
      }
    },
    "device.connection.appSummary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
