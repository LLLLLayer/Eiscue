    "connection.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device connected. Verify screenshots, input, and other capabilities on this OS version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备已连接。截图、输入等能力需在当前系统版本逐项验证。"
          }
        }
      }
    },
    "connection.requiresUSBPairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This OS version cannot start Eiscue pairing from Settings. Connect this device to a computer using USB, then generate and import its Eiscue pairing file. No system pairing prompt will appear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此系统版本不支持从设置发起 Eiscue 配对。请先用 USB 连接电脑，生成并导入这台设备的 Eiscue 配对文件；无需等待系统配对提示。"
          }
        }
      }
    },
    "connection.startLocalBeforePairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the local connection before pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先开启本地连接，再开始配对。"
          }
        }
      }
    },
    "connection.startLocalFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the local connection first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先开启本地连接。"
          }
        }
      }
    },
    "credentials.operationFailed %d": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system Keychain operation failed (%d). No plain-text fallback file was written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
