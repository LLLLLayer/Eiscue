        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待系统配对确认"
          }
        }
      }
    },
    "connection.pairingTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiscue Is Pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiscue 正在配对"
          }
        }
      }
    },
    "connection.preparingPairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing system pairing…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备系统配对…"
          }
        }
      }
    },
    "connection.previewCaptured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new screenshot was captured. This preview is not sent to the model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
