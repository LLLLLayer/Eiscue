    "run.recovered_interruption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last task was interrupted. Check the screen before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次任务已中断。请先查看屏幕，再继续任务。"
