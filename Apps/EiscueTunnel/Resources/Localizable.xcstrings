{
  "sourceLanguage": "en",
  "strings": {
    "tunnel.error.already-started": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN is already starting or on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 已开启或正在开启。"
          }
        }
      }
    },
    "tunnel.error.previous-read-pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN is still closing. Try connecting shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 尚未关闭，请稍后连接。"
          }
        }
      }
    },
    "tunnel.error.incompatible-configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN settings are incompatible. Set up the local VPN again in Eiscue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 配置不兼容，请在 Eiscue 中重新设置本地 VPN。"
          }
        }
      }
    },
    "tunnel.error.stopped-before-ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN stopped during startup. Try connecting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 启动中断，请重新连接。"
          }
        }
      }
    },
    "tunnel.error.packet-write-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN couldn't send data and has disconnected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 无法传输数据，连接已断开。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
