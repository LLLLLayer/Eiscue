{
  "sourceLanguage": "en",
  "strings": {
    "bleCheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth input check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙输入检查"
          }
        }
      }
    },
    "bleCheck.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this page open and leave the screen untouched. Allow Bluetooth and pairing when prompted, and turn on AssistiveTouch for pointer input. Wi-Fi stays unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持此页面打开，请勿触屏。按提示允许蓝牙和配对，并开启辅助触控。不会更改 Wi-Fi 设置。"
          }
        }
      }
    },
    "bleCheck.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard test field"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘测试输入框"
          }
        }
      }
    },
    "bleCheck.target": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointer test target"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击测试区域"
          }
        }
      }
    },
    "bleCheck.clicked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap received"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收到点击"
          }
        }
      }
    },
    "bleCheck.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking Bluetooth input…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查蓝牙输入…"
          }
        }
      }
    },
    "bleCheck.passed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing and taps verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字输入和点击已通过检查。"
          }
        }
      }
    },
    "bleCheck.stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check stopped. See the stage below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查已停止，请查看下方阶段。"
          }
        }
      }
    },
    "bleCheck.reportFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the diagnostic report."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断记录保存失败。"
          }
        }
      }
    },
    "bleCheck.coverageTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking one tap\nLeave the screen untouched"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查一次点击\n请勿触屏"
          }
        }
      }
    }
  },
  "version": "1.0"
}
