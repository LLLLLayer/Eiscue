{
  "sourceLanguage": "en",
  "strings": {
    "attachment.error.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add up to 4 attachments per message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条消息最多添加 4 个附件。"
          }
        }
      }
    },
    "attachment.error.fileSize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a nonempty file up to 20 MB. Images must fit within 2 MB after resizing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择非空且不超过 20 MB 的文件；图片缩小后须不超过 2 MB。"
          }
        }
      }
    },
    "attachment.error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file format is not supported. Choose an image, PDF, or text file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此文件格式。请选择图片、PDF 或文本文件。"
          }
        }
      }
    },
    "attachment.error.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file could not be read. It may be empty, locked, or use an unsupported encoding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此文件，可能为空、已加密或使用了不支持的编码。"
          }
        }
      }
    },
    "attachment.error.image": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image could not be read. Choose one still image up to 40 megapixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此图片。请选择不超过 4000 万像素的单张静态图片。"
          }
        }
      }
    },
    "attachment.error.emptyPDF": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF has no extractable text. Scanned pages need OCR; attach the relevant pages as images instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PDF 没有可提取的文字。扫描页需要 OCR，请将相关页面以图片添加。"
          }
        }
      }
    },
    "attachment.error.textSize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The extracted text exceeds 60 KB. Choose a shorter document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提取的文字超过 60 KB，请选择更短的文档。"
          }
        }
      }
    },
    "attachment.error.pageCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a PDF with no more than 100 pages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择不超过 100 页的 PDF。"
          }
        }
      }
    },
    "attachment.error.cameraUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A camera is not available on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备无法使用相机。"
          }
        }
      }
    },
    "attachment.error.cameraDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in Settings to take a photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许相机权限后拍照。"
          }
        }
      }
    },
    "attachment.file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        }
      }
    },
    "attachment.cameraPhoto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄的照片"
          }
        }
      }
    },
    "attachment.add": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add attachment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加附件"
          }
        }
      }
    },
    "attachment.photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        }
      }
    },
    "attachment.camera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机"
          }
        }
      }
    },
    "attachment.files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        }
      }
    },
    "attachment.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove attachment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除附件"
          }
        }
      }
    },
    "attachment.importing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing attachments…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备附件…"
          }
        }
      }
    },
    "attachment.documentText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extracted document text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提取文档文字"
          }
        }
      }
    },
    "attachment.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 4 attachments · 20 MB each"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 4 个附件 · 每个不超过 20 MB"
          }
        }
      }
    }
  },
  "version": "1.0"
}
