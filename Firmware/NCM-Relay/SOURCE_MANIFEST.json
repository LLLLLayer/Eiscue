  "local_changes": [
    "Build include/source paths relocated into a standalone Firmware/NCM-Relay project.",
    "ESP-IDF version pinned to 5.5.3 (upstream used 5.5.5); TinyUSB versions retained and lock regenerated.",
    "Minimum flash layout changed from 16MB to 4MB; complete original flash is backed up by the explicit flash tool.",
    "USB manufacturer/product/version strings identify Eiscue NCM Relay 1.0.0.",
    "Python flash/inventory/package/link tools and safety guard tests are Eiscue additions.",
    "Shared developer-service startup log no longer claims absence of radio; the Passport-Relay target uses Wi-Fi.",
    "Developer diagnostic page uses transport-neutral text for shared USB and Wi-Fi targets; wire protocol fields are unchanged."
  ]
}
