    "settings.background_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system Live Activity shows device-task progress and lets you stop the task. The system controls its appearance. Optional notifications report the result when Eiscue is in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统实时活动显示任务进展，也可停止任务；样式由系统决定。开启通知后，App 在后台时会提醒任务结果。"
          }
        }
      }
    },
