    "run.recovered_interruption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous run did not finish normally. Check the device before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次执行没有正常结束。请先核查设备当前状态，再决定继续。"
          }
        }
      }
    },
    "run.resolve_interruption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume or end the interrupted task before sending a new message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先继续或结束上次中断的任务，再发送新消息。"
          }
        }
      }
    },
    "run.connect_first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the device button at the top right to pair and connect first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先点右上角设备按钮，完成配对并连接。"
          }
        }
      }
    },
    "run.images_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device tasks require a model that accepts images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备任务需要支持图片输入的模型。"
