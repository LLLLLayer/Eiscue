      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused because the same action did not visibly change the screen. Check the current screen before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复操作后画面没有变化，任务已暂停。请检查当前画面后再继续。"
          }
        }
      }
    },
    "toolError.repeatedStaleFrames": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screenshot could not be used for several actions, so the task is paused. Continue to inspect the screen again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作多次未能使用当前截图，任务已暂停。继续后会重新查看屏幕。"
          }
        }
      }
    },
    "toolError.verificationUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action was sent, but its result couldn't be checked. Check the connection on Eiscue's Device page, then continue. Eiscue will view the screen before acting again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已发送，但未能截图确认结果。请在设备页检查连接后继续；Eiscue 会先查看屏幕，再操作。"
          }
        }
      }
    },
