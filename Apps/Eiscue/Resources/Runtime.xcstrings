    "error.model_region_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini does not support requests from this region. Check its supported regions or use another model service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini 不支持当前请求所在地区。请确认支持范围，或更换模型服务。"
          }
        }
      }
    },
    "settings.language_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows your system language by default. Choose another language in Eiscue’s iOS settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认跟随系统。可在 iOS 的 Eiscue 设置中单独选择语言。"
          }
        }
      }
    },
    "run.paused.toolLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This turn reached its step limit. Continue to recheck the screen and carry on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮已达步骤上限。继续任务时，AI 会先重新查看屏幕。"
          }
        }
      }
    },
    "run.paused.noProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task is not making progress. Check the screen, then continue or add instructions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务暂无进展。请查看屏幕，再继续任务或补充说明。"
          }
        }
      }
    },
    "run.paused.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续任务"
          }
        }
      }
    },
    "run.paused.end": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束任务"
          }
        }
      }
    },
    "run.paused.resume_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue my previous task from the current screen. Observe it again before acting, check which steps have already succeeded, and change approach if the earlier actions made no progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从当前画面继续我刚才的任务。先重新查看屏幕，确认哪些步骤已经完成；如果之前的操作没有进展，请换一种方式。"
          }
        }
      }
    },
    "run.paused.verification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action was sent, but the result could not be checked. Check the connection on the Device page, then continue. AI will view the screen first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已发送，但未能查看结果。请到设备页检查连接后继续，AI 会先重新查看屏幕。"
          }
        }
      }
    },
    "run.paused.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device disconnected. Reconnect from the Device page, then continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备已断开。请到设备页重新连接，再继续任务。"
          }
        }
      }
    },
