    "settings.background_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device tasks use the system Live Activity to show progress and allow cancellation. Its appearance depends on your device and system settings. Optional notifications report only the final status while Eiscue is in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备任务通过系统实时活动显示进展，并允许取消；显示位置由设备和系统设置决定。开启通知后，仅在 App 处于后台时提醒任务的结束状态。"
          }
        }
      }
    },
