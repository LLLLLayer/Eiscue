{
  "sourceLanguage": "en",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your Eiscue board to control this device over Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过蓝牙连接你的 Eiscue 开发板，以操作这台设备。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to this device’s developer services through Eiscue’s local connection or a nearby Eiscue board."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过本机连接或附近的 Eiscue 开发板，连接这台设备的开发者服务。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo to attach to your message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄照片并添加到你要发送的消息中。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your speech into text in the message field."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你说的话转换为输入框中的文字。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe speech on this device without sending a message automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上将语音转换为文字；不会自动发送。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
