{
  "sourceLanguage": "en",
  "strings": {
    "speech.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to talk. Release to finish, or slide up to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话，松开结束，上滑取消。"
          }
        }
      }
    },
    "speech.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入"
          }
        }
      }
    },
    "speech.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop voice input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止语音输入"
          }
        }
      }
    },
    "speech.permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for permission…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待授权…"
          }
        }
      }
    },
    "speech.preparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting the microphone…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在开启麦克风…"
          }
        }
      }
    },
    "speech.listening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在听…"
          }
        }
      }
    },
    "speech.finishing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribing…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在转成文字…"
          }
        }
      }
    },
    "speech.error.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow speech recognition for Eiscue in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 Eiscue 使用语音识别。"
          }
        }
      }
    },
    "speech.error.microphonePermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Eiscue to use the microphone in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 Eiscue 使用麦克风。"
          }
        }
      }
    },
    "speech.error.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is restricted. Type your message instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别受限，请改用文字输入。"
          }
        }
      }
    },
    "speech.error.locale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device or language doesn't support on-device speech recognition. Type your message instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前设备或语言不支持本机语音识别，请改用文字输入。"
          }
        }
      }
    },
    "speech.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device speech recognition is unavailable. Try again later or type your message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机语音识别暂时不可用，请稍后重试或输入文字。"
          }
        }
      }
    },
    "speech.error.microphoneUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone unavailable. Check your microphone or headset and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风不可用，请检查麦克风或耳机后重试。"
          }
        }
      }
    },
    "speech.error.noSpeech": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech recognized. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有识别到语音，请重试。"
          }
        }
      }
    },
    "speech.holdToTalk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to talk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话"
          }
        }
      }
    },
    "speech.slideToCancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to finish · Slide up to cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开结束 · 上滑取消"
          }
        }
      }
    },
    "speech.releaseToCancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开取消"
          }
        }
      }
    },
    "speech.holdHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to talk, then release. Slide up to cancel. With VoiceOver, double-tap to start or stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话，松开结束，上滑取消。使用旁白时，轻点两下开始或停止。"
          }
        }
      }
    },
    "speech.keyboardMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to keyboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换键盘输入"
          }
        }
      }
    },
    "speech.voiceMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to voice input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换语音输入"
          }
        }
      }
    }
  },
  "version": "1.0"
}
