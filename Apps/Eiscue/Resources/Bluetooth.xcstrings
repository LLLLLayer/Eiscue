{
  "sourceLanguage": "en",
  "strings": {
    "bluetooth.method": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board keyboard and mouse"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发板键鼠"
          }
        }
      }
    },
    "bluetooth.connectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your usual Wi-Fi. The board uses Bluetooth for commands and Bluetooth or USB for input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持平常的 Wi-Fi 连接。开发板通过蓝牙接收指令，可选择蓝牙或 USB 输入。"
          }
        }
      }
    },
    "bluetooth.powerDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power an ESP32-C3 or ESP32-S3 board with Eiscue keyboard and mouse firmware from a charger or computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将装有 Eiscue 键鼠固件的 ESP32-C3 或 ESP32-S3 开发板接充电器或电脑供电。"
          }
        }
      }
    },
    "bluetooth.assistiveTouch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable AssistiveTouch in Settings → Accessibility → Touch. Turn on Bluetooth and tap Pair when prompted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「设置 → 辅助功能 → 触控」开启辅助触控，打开蓝牙并确认配对。"
          }
        }
      }
    },
    "bluetooth.connectTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接开发板"
          }
        }
      }
    },
    "bluetooth.connectButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "bluetooth.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接…"
          }
        }
      }
    },
    "bluetooth.disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开"
          }
        }
      }
    },
    "bluetooth.shareTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享屏幕"
          }
        }
      }
    },
    "bluetooth.shareDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the recording icon, then Start Broadcast. Device tasks send screenshots to your AI service as needed. No audio is recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点录屏图标，再点「开始直播」。任务中按需向你的 AI 服务发送截图，不采集音频。"
          }
        }
      }
    },
    "bluetooth.stopSharing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop sharing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止共享"
          }
        }
      }
    },
    "bluetooth.shareButtonHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start screen sharing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始屏幕共享"
          }
        }
      }
    },
    "bluetooth.verifyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查输入"
          }
        }
      }
    },
    "bluetooth.verifyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks taps and typing; keep the screen untouched. Repeat after rotation or reconnection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查点击和输入时请勿触屏；旋转或重连后需重查。"
          }
        }
      }
    },
    "bluetooth.verifyButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始检查"
          }
        }
      }
    },
    "bluetooth.verifyAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        }
      }
    },
    "bluetooth.readyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to chat and describe your task. Turn off AI control here for chat only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到对话，告诉 AI 要做什么。仅对话时，在此关闭 AI 操作即可。"
          }
        }
      }
    },
    "bluetooth.verifying": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking taps and typing…\nPlease leave the screen untouched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查点击和输入…\n请勿触屏。"
          }
        }
      }
    },
    "bluetooth.keyboardCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking typing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查输入"
          }
        }
      }
    },
    "bluetooth.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "bluetooth.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "bluetooth.validationPassed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device control is ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备操作已就绪"
          }
        }
      }
    },
    "bluetooth.validationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check incomplete. Keep AssistiveTouch on and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查未完成。请开启辅助触控后重试。"
          }
        }
      }
    },
    "bluetooth.validationInterrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this page open without rotating the device, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持此页面打开，不要旋转设备，然后重试。"
          }
        }
      }
    },
    "bluetooth.keyboardFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text received. Check the input connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未收到文字。请检查输入连接后重试。"
          }
        }
      }
    },
    "bluetooth.stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection or screen sharing ended. The task stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接或屏幕共享已结束，任务已停止。"
          }
        }
      }
    },
    "bluetooth.inputRoute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方式"
          }
        }
      }
    },
    "bluetooth.inputBluetooth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙输入"
          }
        }
      }
    },
    "bluetooth.inputUSB": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 输入"
          }
        }
      }
    },
    "bluetooth.usbPowerDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect S3 USB/OTG to your iPhone or iPad; COM/UART is for a computer. Lightning needs a powered USB camera or host adapter; a regular Lightning to USB-C cable won’t work. Keep Bluetooth on for commands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 S3 USB／OTG 口接到 iPhone 或 iPad，COM／UART 口供电脑使用。Lightning 需用 USB 相机／主机转接器并接电源，普通 Lightning 转 USB-C 线不可用。指令通过蓝牙传输。"
          }
        }
      }
    },
    "bluetooth.outputChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input changed. Reconnect the board and check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方式已切换，请重新连接开发板并检查。"
          }
        }
      }
    },
    "bluetooth.firstS3Connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First S3 setup: restart the board, then connect within one minute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "S3 首次设置：重新通电，并在一分钟内连接。"
          }
        }
      }
    },
    "bluetooth.usbTouchMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check incomplete: no tap received. Connect USB/OTG to this iPhone or iPad, not the computer. COM/UART is for the computer. Power the adapter, turn on AssistiveTouch, then reconnect and check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查未完成：未收到点击。USB／OTG 口应接这台 iPhone 或 iPad，COM／UART 口用于电脑。请给转接器供电、开启辅助触控，再重新连接并检查。"
          }
        }
      }
    },
    "bluetooth.waitingForUSB": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for USB recognition…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待设备识别 USB…"
          }
        }
      }
    },
    "bluetooth.usbConfirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is USB connected to this device?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 接的是这台设备吗？"
          }
        }
      }
    },
    "bluetooth.usbConfirmDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check sends taps and typing. USB/OTG must connect to this iPhone or iPad; COM/UART can connect to a computer for power. USB detection cannot tell which device is connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查会发送点击和文字。USB／OTG 口须接这台 iPhone 或 iPad；COM／UART 可接电脑供电。检测到 USB 不能确认接的是哪台设备。"
          }
        }
      }
    },
    "bluetooth.usbConfirmButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected; start check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接，开始检查"
          }
        }
      }
    },
    "bluetooth.companionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press OK to stop. Release, then hold to unlock; reconnect and check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 OK 停止；松开后长按解锁，再重新连接并检查。"
          }
        }
      }
    },
    "bluetooth.hardwareStopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped with the board button. Release OK, then hold for 1.5 seconds to unlock. Reconnect and check before starting another device task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过开发板停止。松开 OK，再长按 1.5 秒解锁；重新连接并检查后才能继续操作设备。"
          }
        }
      }
    },
    "bluetooth.hardwareStoppedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped with board button"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过开发板停止"
          }
        }
      }
    },
    "bluetooth.validationTouchTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking taps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查点击"
          }
        }
      }
    },
    "bluetooth.validationInputTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking typing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查输入"
          }
        }
      }
    },
    "bluetooth.validationProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device check progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备检查进度"
          }
        }
      }
    },
    "bluetooth.validationCompleteTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查完成"
          }
        }
      }
    },
    "bluetooth.validationFailedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check incomplete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查未完成"
          }
        }
      }
    }
  },
  "version": "1.0"
}
