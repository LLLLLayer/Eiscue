{
  "sourceLanguage": "en",
  "strings": {
    "setup.progress %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup step %1$lld of 3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置第 %1$lld 步，共 3 步"
          }
        }
      }
    },
    "setup.welcome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello, I’m Eiscue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我是 Eiscue。"
          }
        }
      }
    },
    "setup.welcomeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant, right on your device. Let’s take a minute to get started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的随身助手。花一分钟，了解如何开始。"
          }
        }
      }
    },
    "setup.chat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk naturally"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像聊天一样使用"
          }
        }
      }
    },
    "setup.chatDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question or describe what you want to do."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接提问，或告诉我你想做什么。"
          }
        }
      }
    },
    "setup.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get help on your device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让设备帮你做事"
          }
        }
      }
    },
    "setup.deviceDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your device using the top-right button. Tap + beside the message field to let AI control it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过右上角按钮连接设备，再点输入框旁的加号，允许 AI 操作设备。"
          }
        }
      }
    },
    "setup.model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先连接 AI。"
          }
        }
      }
    },
    "setup.modelDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your model name and API key. Eiscue uses these to understand your requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写模型名称和 API 密钥，让 Eiscue 理解你的要求。"
          }
        }
      }
    },
    "setup.modelReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is configured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 已配置"
          }
        }
      }
    },
    "setup.editModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit AI connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 AI 配置"
          }
        }
      }
    },
    "setup.configureModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置 AI"
          }
        }
      }
    },
    "setup.modelHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the connection details from your AI provider. Other options already have defaults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 AI 服务商提供的信息即可，其他选项已有默认值。"
          }
        }
      }
    },
    "setup.deviceSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好你的设备。"
          }
        }
      }
    },
    "setup.deviceSetupDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device control needs pairing and a prepared developer environment. You can start with chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作设备需要先配对，并准备好系统开发环境。你也可以先使用聊天。"
          }
        }
      }
    },
    "setup.developerMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Developer Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启开发者模式"
          }
        }
      }
    },
    "setup.developerModeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find it in Settings → Privacy & Security. Restart and confirm if asked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「设置 → 隐私与安全性」中开启，按提示重启并确认。"
          }
        }
      }
    },
    "setup.pairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对这台设备"
          }
        }
      }
    },
    "setup.systemPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this guide, use the device button at the top right to start pairing. Choose Eiscue in the system pairing settings and enter the code shown in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成引导后，点右上角设备按钮开始配对。再到系统配对设置选择 Eiscue，输入 App 显示的配对码。"
          }
        }
      }
    },
    "setup.usbPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version still needs a computer for initial pairing on iOS or iPadOS 26. The Eiscue tool creates a pairing identity; import it here to authorize the connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本在 iOS / iPadOS 26 上仍需电脑完成首次配对。电脑工具生成配对身份，导入后用于连接认证。"
          }
        }
      }
    },
    "setup.computerGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer setup instructions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看电脑配对步骤"
          }
        }
      }
    },
    "setup.pairingReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing identity saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对身份已保存"
          }
        }
      }
    },
    "setup.importTransfer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from computer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入电脑发送的配对"
          }
        }
      }
    },
    "setup.importFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose pairing file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择配对文件"
          }
        }
      }
    },
    "setup.localConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow a local connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本地连接"
          }
        }
      }
    },
    "setup.localConnectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the VPN prompt when it appears. This connection stays on your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现系统 VPN 提示时选择允许，这条连接只用于本机。"
          }
        }
      }
    },
    "setup.localReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local connection is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地连接已开启"
          }
        }
      }
    },
    "setup.enableConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable local connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启本地连接"
          }
        }
      }
    },
    "setup.deviceLater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can chat first and finish setup later using the device button at the top right."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以先聊天，之后再点右上角设备按钮完成连接。"
          }
        }
      }
    },
    "setup.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start using Eiscue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "setup.begin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始设置"
          }
        }
      }
    },
    "setup.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "setup.configureLater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up AI later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后配置 AI"
          }
        }
      }
    }
  },
  "version": "1.0"
}
