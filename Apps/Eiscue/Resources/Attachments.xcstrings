{
  "sourceLanguage": "en",
  "strings": {
    "attachment.error.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add up to 4 attachments per message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条消息最多添加 4 个附件。"
          }
        }
      }
    },
    "attachment.error.fileSize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a nonempty file up to 20 MB. Images must fit within 2 MB after resizing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择非空且不超过 20 MB 的文件；图片缩小后须不超过 2 MB。"
          }
        }
      }
    },
    "attachment.error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported format. Choose an image, PDF, or text file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此格式，请选择图片、PDF 或文本文件。"
          }
        }
      }
    },
    "attachment.error.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read this file. It may be empty, encrypted, or use unsupported text encoding. Try another file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件，可能为空、已加密或文字编码不受支持。请换一个文件。"
          }
        }
      }
    },
    "attachment.error.image": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read this image. Choose a still image up to 40 megapixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取图片，请选择不超过 4000 万像素的静态图片。"
          }
        }
      }
    },
    "attachment.error.emptyPDF": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF has no readable text. Add the pages you need as images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PDF 无法提取文字，请将需要的页面作为图片添加。"
          }
        }
      }
    },
    "attachment.error.textSize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Document text exceeds 60 KB. Choose a shorter document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提取的文字超过 60 KB，请选择更短的文档。"
          }
        }
      }
    },
    "attachment.error.pageCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a PDF with no more than 100 pages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择不超过 100 页的 PDF。"
          }
        }
      }
    },
    "attachment.error.cameraUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera unavailable. Choose a photo instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机不可用，请选择已有照片。"
          }
        }
      }
    },
    "attachment.error.cameraDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Eiscue to use the camera in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 Eiscue 使用相机。"
          }
        }
      }
    },
    "attachment.file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        }
      }
    },
    "attachment.cameraPhoto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄的照片"
          }
        }
      }
    },
    "attachment.add": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add attachment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加附件"
          }
        }
      }
    },
    "attachment.photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择照片"
          }
        }
      }
    },
    "attachment.camera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照"
          }
        }
      }
    },
    "attachment.files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose files"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件"
          }
        }
      }
    },
    "attachment.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove attachment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除附件"
          }
        }
      }
    },
    "attachment.importing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing attachments…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备附件…"
          }
        }
      }
    },
    "attachment.documentText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extracted document text"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提取文档文字"
          }
        }
      }
    },
    "attachment.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 4 attachments · 20 MB each"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 4 个附件 · 每个不超过 20 MB"
          }
        }
      }
    }
  },
  "version": "1.0"
}
