{
  "sourceLanguage": "en",
  "strings": {
    "messageSharing.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Attachment missing. Add the file again to share it." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "找不到原附件，请重新添加文件后分享。" } }
      }
    },
    "messageSharing.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This message has nothing to share." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "这条消息没有可分享的内容。" } }
      }
    },
    "messageSharing.preparation": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Couldn't share this message. Try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "暂时无法分享，请重试。" } }
      }
    },
    "messageSharing.delivery": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "The selected app couldn't share this message. Try another sharing option." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "所选 App 分享失败，请换一种分享方式。" } }
      }
    }
  },
  "version": "1.0"
}
