    "run.preparation_interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app or connection state changed before this message was sent. Return to Eiscue and check the connection, then continue or end the task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 或连接状态已变化，消息尚未发送。请返回 Eiscue 检查连接，再继续或结束任务。"
          }
        }
      }
    },
    "run.unknown_delivery": {
      "extractionState": "manual",
      "localizations": {
