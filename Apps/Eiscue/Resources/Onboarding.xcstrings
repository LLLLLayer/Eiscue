{
  "sourceLanguage": "en",
  "strings": {
    "setup.progress %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup step %1$lld of 3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置第 %1$lld 步，共 3 步"
          }
        }
      }
    },
    "setup.welcome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello, I’m Eiscue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我是 Eiscue。"
          }
        }
      }
    },
    "setup.welcomeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your AI assistant, wherever you go."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的随身 AI 助手。"
          }
        }
      }
    },
    "setup.chat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 AI 对话"
          }
        }
      }
    },
    "setup.chatDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question or describe your task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接提问，或描述你的任务。"
          }
        }
      }
    },
    "setup.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let AI operate your device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 操作设备"
          }
        }
      }
    },
    "setup.deviceDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect with the device button at the top right. AI control is on by default; turn it off there for chat only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点右上角设备按钮连接。AI 操作默认开启，仅对话时可在设备页关闭。"
          }
        }
      }
    },
    "setup.model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 AI"
          }
        }
      }
    },
    "setup.modelDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the service URL, model name, and API key from your AI provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写 AI 服务商提供的服务地址、模型 ID 和 API Key。"
          }
        }
      }
    },
    "setup.modelReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is configured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 已配置"
          }
        }
      }
    },
    "setup.editModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit AI settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 AI 配置"
          }
        }
      }
    },
    "setup.configureModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置 AI"
          }
        }
      }
    },
    "setup.modelHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep the defaults for other options."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他选项使用默认值即可。"
          }
        }
      }
    },
    "setup.deviceSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接设备"
          }
        }
      }
    },
    "setup.deviceSetupDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection needs pairing and developer setup. You can start with chat and set it up later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接方式需先配对并完成开发者设置，也可以稍后设置，先开始对话。"
          }
        }
      }
    },
    "setup.developerMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Developer Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启开发者模式"
          }
        }
      }
    },
    "setup.developerModeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in Settings → Privacy & Security → Developer Mode. Restart and confirm when prompted. Before first use, prepare the device with Xcode or compatible developer tools on a computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启「设置 → 隐私与安全性 → 开发者模式」，按提示重启并确认。首次使用前，还需用电脑上的 Xcode 或兼容开发工具完成设备准备。"
          }
        }
      }
    },
    "setup.pairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对这台设备"
          }
        }
      }
    },
    "setup.systemPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Start pairing in the guide. Choose Eiscue in the system pairing settings and enter the code shown in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在引导中点“开始配对”，然后在系统配对设置中选择 Eiscue，输入 App 显示的配对码。"
          }
        }
      }
    },
    "setup.usbPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS or iPadOS 26, initial pairing needs a USB connection to a computer. Create a pairing file with the Eiscue tool, then import it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS / iPadOS 26 首次配对需用 USB 连接电脑。用 Eiscue 工具生成配对文件，再导入这里。"
          }
        }
      }
    },
    "setup.computerGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View pairing instructions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看配对步骤"
          }
        }
      }
    },
    "setup.pairingReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存配对授权"
          }
        }
      }
    },
    "setup.importTransfer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from computer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入电脑发送的配对"
          }
        }
      }
    },
    "setup.importFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import pairing file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入配对文件"
          }
        }
      }
    },
    "setup.localConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow local VPN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本地 VPN"
          }
        }
      }
    },
    "setup.localConnectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the system VPN prompt. This connection controls only this device and may disconnect another VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统 VPN 提示中点「允许」。此连接仅控制本机，可能断开其他 VPN。"
          }
        }
      }
    },
    "setup.localReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 已开启"
          }
        }
      }
    },
    "setup.enableConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable local VPN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启本地 VPN"
          }
        }
      }
    },
    "setup.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start using Eiscue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "setup.begin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始设置"
          }
        }
      }
    },
    "setup.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "setup.configureLater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up AI later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后配置 AI"
          }
        }
      }
    },
    "setup.boardPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create this device’s Eiscue pairing file on a computer, then import it here. Connecting the board does not replace pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先用电脑生成这台设备的 Eiscue 配对文件，再导入。连接开发板不能代替配对。"
          }
        }
      }
    },
    "setup.boardConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect USB network board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 USB 网卡开发板"
          }
        }
      }
    },
    "setup.boardConnectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an ESP32-S3 board running Eiscue USB network firmware. Lightning devices need a powered USB host adapter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入装有 Eiscue USB 网卡固件的 ESP32-S3 开发板。Lightning 设备需使用带供电的 USB 主机转接器。"
          }
        }
      }
    },
    "setup.wirelessBoardConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a Wi-Fi board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Wi-Fi 开发板"
          }
        }
      }
    },
    "setup.wirelessBoardConnectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an ESP32-C3 board with Eiscue Wi-Fi firmware. Join its Eiscue-xxxx network in Settings; the password is in the board setup details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用装有 Eiscue Wi-Fi 固件的 ESP32-C3 开发板。在系统设置中加入 Eiscue-xxxx 网络，密码见开发板连接信息。"
          }
        }
      }
    },
    "setup.wirelessBoardNetworkNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI requests need cellular data. A company VPN may block access to the board’s local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 请求需使用蜂窝数据。公司 VPN 可能限制访问开发板的局域网。"
          }
        }
      }
    },
    "setup.wirelessBoardGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi board guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 开发板设置说明"
          }
        }
      }
    },
    "setup.startChat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start chatting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先开始对话"
          }
        }
      }
    },
    "setup.savedPairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对已保存"
          }
        }
      }
    },
    "setup.firstPairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次配对"
          }
        }
      }
    },
    "setup.savedPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pairing identity is already saved. Connect to check whether it still works."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到已保存的配对授权，连接后会检查是否仍然有效。"
          }
        }
      }
    },
    "setup.computerPairingIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First-time setup needs a computer. Import the pairing file when it is ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次配对需要电脑协助，准备好后导入配对文件。"
          }
        }
      }
    },
    "setup.systemPairingIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start pairing, then follow the instructions in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始配对后，按系统设置中的提示完成授权。"
          }
        }
      }
    },
    "setup.pairAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新配对"
          }
        }
      }
    },
    "setup.pairAgainConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the saved pairing?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除已保存的配对？"
          }
        }
      }
    },
    "setup.pairAgainDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes only Eiscue’s pairing identity. You will need to pair again or import a new pairing file. Model settings and the system VPN configuration are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除 Eiscue 保存的配对身份，之后需重新配对或导入文件。模型设置和系统 VPN 配置会保留。"
          }
        }
      }
    },
    "setup.connectDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接设备"
          }
        }
      }
    },
    "setup.connectionHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup help"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置帮助"
          }
        }
      }
    },
    "setup.preparationTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First-time preparation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次设置需要什么"
          }
        }
      }
    },
    "setup.computerTrustTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a computer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接电脑"
          }
        }
      }
    },
    "setup.computerTrustDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this iPhone or iPad to a computer with a USB data cable. Unlock the device and trust the computer when prompted. An already trusted computer may not show the prompt again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 USB 数据线连接这台 iPhone 或 iPad 与电脑，解锁并按提示信任电脑。已经信任过的电脑可能不会再次弹窗。"
          }
        }
      }
    },
    "setup.transferTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare and import the pairing file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备并导入配对文件"
          }
        }
      }
    },
    "setup.transferDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the Eiscue pairing tool on the computer to generate EiscuePairingTransfer.json. Transfer it to this device, then return here and choose Import pairing file. Keep the file private."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上用 Eiscue 配对工具生成 EiscuePairingTransfer.json。把文件传到这台设备，再回到这里选择“导入配对文件”。请勿公开分享该文件。"
          }
        }
      }
    },
    "setup.computerRequiredNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version cannot complete first-time pairing on the phone alone. After preparation, the local VPN route runs without a computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本还不能只用手机完成首次配对。准备完成后，App 内连接的日常使用无需电脑。"
          }
        }
      }
    },
    "setup.vpnPermissionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the local VPN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本地 VPN"
          }
        }
      }
    },
    "setup.vpnPermissionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When starting pairing or connecting, allow Eiscue to add its VPN configuration if iOS asks. Eiscue checks device control after connecting; enabling the VPN alone does not complete setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始配对或连接时，如果系统询问是否添加 VPN 配置，请点“允许”。连接后 App 会检查设备控制，VPN 开启本身不代表连接成功。"
          }
        }
      }
    },
    "setup.savedSettingsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why are settings still saved?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么重装后还有配置？"
          }
        }
      }
    },
    "setup.savedSettingsDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalling the app may leave its pairing identity in the iPhone Keychain. Choose Pair again on the setup page if you want to remove that identity. This does not revoke the device’s system trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载 App 后，iPhone 钥匙串可能仍保留配对身份。要清除它，可在引导页选择“重新配对”。这不会撤销设备的系统信任。"
          }
        }
      }
    },
    "setup.savedVPNDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS stores VPN configurations separately. To test the VPN permission prompt again, remove only Eiscue’s VPN configuration in iPhone Settings, then reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 配置由 iOS 单独保存。若要重新测试 VPN 授权弹窗，请先在 iPhone 设置中移除 Eiscue 的 VPN 配置，再回来连接。"
          }
        }
      }
    },
    "setup.commandTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run on your Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上运行"
          }
        }
      }
    },
    "setup.commandRequirements": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You need the Eiscue source folder, Xcode, Python 3 and Rust 1.96.0 on your Mac. First use Xcode to prepare this device for development."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 需备有 Eiscue 项目源码、Xcode、Python 3 和 Rust 1.96.0。先用 Xcode 完成这台设备的开发准备。"
          }
        }
      }
    },
    "setup.commandLocation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this device by USB and keep it unlocked. Open Terminal in the Eiscue project folder, then paste this command and press Return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 USB 连接并解锁这台设备。在 Eiscue 项目文件夹中打开终端，粘贴以下命令并按回车。"
          }
        }
      }
    },
    "setup.copyCommand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy command"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制命令"
          }
        }
      }
    },
    "setup.commandCopied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制"
          }
        }
      }
    },
    "setup.commandSelection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select this device and confirm in Terminal. The tool generates a pairing file and sends it to Eiscue by USB; you do not need to find or enter a device ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按终端提示选择这台设备并确认。工具会生成配对文件并通过 USB 发给 Eiscue，无需查找或填写设备编号。"
          }
        }
      }
    },
    "setup.commandImport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it finishes, close this help page and choose Import from computer, then Connect device. The command does not import the identity or start a VPN automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成后关闭帮助，点“导入电脑发送的配对”，再点“连接设备”。命令不会自动导入身份或开启 VPN。"
          }
        }
      }
    },
    "setup.commandClipboardHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Universal Clipboard enabled, paste directly on your Mac. Otherwise, enter the displayed command on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用通用剪贴板时，可直接在 Mac 粘贴；否则在 Mac 输入上面的命令。"
          }
        }
      }
    },
    "setup.inlineSystemPreparation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Developer Mode and finish device preparation in Xcode or compatible computer tools before pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先开启开发者模式，并用 Xcode 或兼容的电脑工具完成设备准备，再开始配对。"
          }
        }
      }
    },
    "setup.inlineTransferReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your computer sent a pairing file. Import it to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收到电脑发送的配对文件，导入后即可继续连接。"
          }
        }
      }
    },
    "setup.transferReadyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing file received"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收到配对文件"
          }
        }
      }
    },
    "setup.stepMacTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare your Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备 Mac"
          }
        }
      }
    },
    "setup.stepMacDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Xcode 26+, Python 3.9+ and Rust 1.96.0. Keep your Mac online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Xcode 26+、Python 3.9+、Rust 1.96.0，并保持联网。"
          }
        }
      }
    },
    "setup.stepPhoneTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect by USB"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 连接设备"
          }
        }
      }
    },
    "setup.stepPhoneDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect by USB and trust your Mac. Enable Developer Mode in Settings → Privacy & Security, then finish device preparation in Xcode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 连接并信任 Mac。在“设置 → 隐私与安全性”开启开发者模式，再用 Xcode 完成设备准备。"
          }
        }
      }
    },
    "setup.stepRunTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the command"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行命令"
          }
        }
      }
    },
    "setup.stepRunDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste into Mac Terminal from any folder. It downloads the source and starts setup; select this device when prompted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 终端任意目录粘贴，自动下载源码并运行；按提示选择这台设备。"
          }
        }
      }
    },
    "setup.terminalLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Terminal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 终端"
          }
        }
      }
    },
    "setup.stepImportTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入配对"
          }
        }
      }
    },
    "setup.stepImportWaiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your computer sends the file, the import button appears here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑发送完成后，这里会自动显示导入按钮。"
          }
        }
      }
    },
    "setup.chooseExistingFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an existing file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已有配对文件"
          }
        }
      }
    },
    "setup.stepConnectTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接设备"
          }
        }
      }
    },
    "setup.stepConnectAfterImport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After importing, choose Connect device and follow the system authorization prompts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入后点“连接设备”，按系统提示完成授权。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
