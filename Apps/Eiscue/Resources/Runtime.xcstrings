    "error.model_region_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini rejected this request because its API is unavailable in the region of the request. Check the model service’s supported regions, or choose a service available in your region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini 因当前请求所在地区不受支持而拒绝了请求。请确认模型服务支持的地区，或改用当地可用的模型服务。"
          }
        }
      }
    },
    "settings.language_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows your preferred app language. Change it in the system settings for Eiscue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随 App 的首选语言，可在系统的 Eiscue 设置中更改。"
          }
        }
      }
    },
    "run.paused.toolLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This turn reached its step limit. Continue to check the current screen and pick up the task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮操作已达到步骤上限。点击“继续任务”，AI 会先重新查看屏幕再接着处理。"
          }
        }
      }
    },
    "run.paused.noProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task could not make progress. Check the device, then continue or give another instruction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务暂时无法继续推进。请查看设备，再继续任务或补充说明。"
          }
        }
      }
    },
    "run.paused.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续任务"
          }
        }
      }
    },
    "run.paused.end": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束任务"
          }
        }
      }
    },
    "run.paused.resume_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue my previous task from the current screen. Observe it again before acting, check which steps have already succeeded, and change approach if the earlier actions made no progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从当前画面继续我刚才的任务。先重新查看屏幕，确认哪些步骤已经完成；如果之前的操作没有进展，请换一种方式。"
          }
        }
      }
    },
    "run.paused.verification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action was sent, but its result could not be observed. Restore screen sharing before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已发送，但未能查看结果。请恢复屏幕共享后再继续。"
          }
        }
      }
    },
    "run.paused.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device connection was lost. Reconnect from the Device page, then continue this task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备连接已断开。请到设备页重新连接，再继续此任务。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
