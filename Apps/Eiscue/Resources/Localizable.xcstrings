    "connection.openPairingSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings → Privacy & Security → Developer Mode, select Eiscue, then tap Pair. Return to Eiscue for the code and enter it in Settings. Return to Eiscue when done."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往「设置 → 隐私与安全性 → 开发者模式」，选择 Eiscue，再点“配对”。返回 App 查看验证码，回到系统输入；完成后返回 App。"
          }
        }
      }
    },
