{
  "sourceLanguage": "en",
  "strings": {
    "setup.progress %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup step %1$lld of 3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置第 %1$lld 步，共 3 步"
          }
        }
      }
    },
    "setup.welcome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello, I’m Eiscue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我是 Eiscue。"
          }
        }
      }
    },
    "setup.welcomeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your AI assistant, wherever you go."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的随身 AI 助手。"
          }
        }
      }
    },
    "setup.chat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 AI 对话"
          }
        }
      }
    },
    "setup.chatDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question or describe your task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接提问，或描述你的任务。"
          }
        }
      }
    },
    "setup.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let AI operate your device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 操作设备"
          }
        }
      }
    },
    "setup.deviceDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect with the device button at the top right. AI control is on by default; turn it off there for chat only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点右上角设备按钮连接。AI 操作默认开启，仅对话时可在设备页关闭。"
          }
        }
      }
    },
    "setup.model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 AI"
          }
        }
      }
    },
    "setup.modelDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the service URL, model name, and API key from your AI provider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写 AI 服务商提供的服务地址、模型 ID 和 API Key。"
          }
        }
      }
    },
    "setup.modelReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is configured"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 已配置"
          }
        }
      }
    },
    "setup.editModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit AI settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 AI 配置"
          }
        }
      }
    },
    "setup.configureModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up AI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置 AI"
          }
        }
      }
    },
    "setup.modelHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep the defaults for other options."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他选项使用默认值即可。"
          }
        }
      }
    },
    "setup.deviceSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接设备"
          }
        }
      }
    },
    "setup.deviceSetupDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection needs pairing and developer setup. You can start with chat and set it up later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接方式需先配对并完成开发者设置，也可以稍后设置，先开始对话。"
          }
        }
      }
    },
    "setup.developerMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Developer Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启开发者模式"
          }
        }
      }
    },
    "setup.developerModeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in Settings → Privacy & Security → Developer Mode. Restart and confirm when prompted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启「设置 → 隐私与安全性 → 开发者模式」，按提示重启并确认。"
          }
        }
      }
    },
    "setup.pairing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对这台设备"
          }
        }
      }
    },
    "setup.systemPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this guide, tap the device button to start pairing. Select Eiscue in system pairing settings and enter the code shown in the App."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成引导后，点设备按钮开始配对。在系统配对设置中选择 Eiscue，输入 App 显示的配对码。"
          }
        }
      }
    },
    "setup.usbPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS or iPadOS 26, initial pairing needs a USB connection to a computer. Create a pairing file with the Eiscue tool, then import it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS / iPadOS 26 首次配对需用 USB 连接电脑。用 Eiscue 工具生成配对文件，再导入这里。"
          }
        }
      }
    },
    "setup.computerGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View pairing instructions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看配对步骤"
          }
        }
      }
    },
    "setup.pairingReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存配对授权"
          }
        }
      }
    },
    "setup.importTransfer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import pairing from computer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入电脑配对文件"
          }
        }
      }
    },
    "setup.importFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import pairing file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入配对文件"
          }
        }
      }
    },
    "setup.localConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow local VPN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本地 VPN"
          }
        }
      }
    },
    "setup.localConnectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the system VPN prompt. This connection controls only this device and may disconnect another VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统 VPN 提示中点「允许」。此连接仅控制本机，可能断开其他 VPN。"
          }
        }
      }
    },
    "setup.localReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local VPN is on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地 VPN 已开启"
          }
        }
      }
    },
    "setup.enableConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable local VPN"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启本地 VPN"
          }
        }
      }
    },
    "setup.deviceLater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can finish device setup later using the top-right device button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可稍后点右上角设备按钮，完成连接设置。"
          }
        }
      }
    },
    "setup.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start using Eiscue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "setup.begin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始设置"
          }
        }
      }
    },
    "setup.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "setup.configureLater": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up AI later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后配置 AI"
          }
        }
      }
    },
    "setup.boardPairingDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create this device’s Eiscue pairing file on a computer, then import it here. Connecting the board does not replace pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先用电脑生成这台设备的 Eiscue 配对文件，再导入。连接开发板不能代替配对。"
          }
        }
      }
    },
    "setup.boardConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect USB network board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 USB 网卡开发板"
          }
        }
      }
    },
    "setup.boardConnectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an ESP32-S3 board running Eiscue USB network firmware. Lightning devices need a powered USB host adapter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入装有 Eiscue USB 网卡固件的 ESP32-S3 开发板。Lightning 设备需使用带供电的 USB 主机转接器。"
          }
        }
      }
    },
    "setup.wirelessBoardConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a Wi-Fi board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Wi-Fi 开发板"
          }
        }
      }
    },
    "setup.wirelessBoardConnectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an ESP32-C3 board with Eiscue Wi-Fi firmware. Join its Eiscue-xxxx network in Settings; the password is in the board setup details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用装有 Eiscue Wi-Fi 固件的 ESP32-C3 开发板。在系统设置中加入 Eiscue-xxxx 网络，密码见开发板连接信息。"
          }
        }
      }
    },
    "setup.wirelessBoardNetworkNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI requests need cellular data. A company VPN may block access to the board’s local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 请求需使用蜂窝数据。公司 VPN 可能限制访问开发板的局域网。"
          }
        }
      }
    },
    "setup.wirelessBoardGuide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi board guide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi 开发板设置说明"
          }
        }
      }
    }
  },
  "version": "1.0"
}
