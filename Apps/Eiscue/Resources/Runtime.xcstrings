        }
      }
    },
    "run.reconnect_first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect the device before resuming the task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先重新连接设备，再继续任务。"
          }
        }
      }
    },
    "run.resume_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have checked the current state. Continue the previous task, observing the screen again first. Do not repeat actions whose outcome is uncertain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核查当前状态。请继续刚才的任务；先重新观察，不要重复结果不确定的操作。"
          }
        }
      }
    },
    "run.ended_by_user": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The user ended the interrupted task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户结束了中断任务。"
          }
        }
      }
    },
    "run.preparing": {
