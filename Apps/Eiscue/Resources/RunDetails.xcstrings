    "runDetails.usage.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts come from model responses, with no cost estimate. Cache counts may be included in input. Partial totals include only reported values; missing values are not zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计来自模型返回，不估算费用。缓存数量可能已计入输入。“部分”仅合计已提供的数据，缺失值不按 0 计算。"
          }
        }
      }
    }
