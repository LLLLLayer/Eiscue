      }
    },
    "run.resolve_interruption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue or end the interrupted task before sending a new message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先继续或结束上次任务，再发送新消息。"
          }
        }
      }
    },
    "run.connect_first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Device at the top right to finish setup and connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请点右上角设备按钮，完成设置并连接。"
          }
        }
      }
    },
    "run.images_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device tasks need a model that supports images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作设备需要支持图片的模型。"
          }
        }
      }
    },
    "run.reconnect_first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect the device, then continue the task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新连接设备，再继续任务。"
          }
        }
      }
    },
    "run.resume_prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have checked the current state. Continue the previous task, observing the screen again first. Do not repeat actions whose outcome is uncertain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核查当前状态。请继续刚才的任务；先重新观察，不要重复结果不确定的操作。"
          }
        }
      }
    },
    "run.ended_by_user": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You ended the interrupted task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已结束中断的任务。"
          }
        }
      }
    },
    "run.preparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备任务"
          }
        }
      }
