{
  "sourceLanguage": "en",
  "strings": {
    "bluetooth.method": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Board keyboard and mouse"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发板键鼠"
          }
        }
      }
    },
    "bluetooth.connectionDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your usual Wi-Fi. Connect board commands over Bluetooth; choose Bluetooth or USB input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续使用平常的 Wi-Fi，通过蓝牙连接开发板，可选择蓝牙或 USB 输入。"
          }
        }
      }
    },
    "bluetooth.powerDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an ESP32-C3 or ESP32-S3 board configured with Eiscue HID firmware. Connect it to a charger or computer for power. No cable to your iPhone is needed for Bluetooth input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已配置 Eiscue 键鼠固件的 ESP32-C3 或 ESP32-S3 开发板。接充电器或电脑供电即可；选择蓝牙输入时，不用插到 iPhone。"
          }
        }
      }
    },
    "bluetooth.assistiveTouch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Settings → Accessibility → Touch → AssistiveTouch. Keep Bluetooth on and allow the pairing prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「设置 → 辅助功能 → 触控 → 辅助触控」。保持蓝牙开启，出现配对提示时点「配对」。"
          }
        }
      }
    },
    "bluetooth.connectTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接开发板"
          }
        }
      }
    },
    "bluetooth.connectButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接开发板"
          }
        }
      }
    },
    "bluetooth.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接…"
          }
        }
      }
    },
    "bluetooth.disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接"
          }
        }
      }
    },
    "bluetooth.shareTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启屏幕共享"
          }
        }
      }
    },
    "bluetooth.shareDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the recording icon, then choose Start Broadcast in the system panel. Eiscue uses your screen to guide the AI; screenshots are sent to your configured model only during device tasks. Microphone audio is not captured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方录屏图标，在系统面板中点「开始直播」。Eiscue 会读取屏幕，仅在设备任务中将截图发送给你配置的模型；不会录制麦克风声音。"
          }
        }
      }
    },
    "bluetooth.stopSharing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop screen sharing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止屏幕共享"
          }
        }
      }
    },
    "bluetooth.shareButtonHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system screen sharing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统屏幕共享"
          }
        }
      }
    },
    "bluetooth.verifyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check device control"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证设备操作"
          }
        }
      }
    },
    "bluetooth.verifyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short check confirms where the board clicks and whether it can enter text. Leave the screen untouched during the check. Repeat after rotating the device or reconnecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过简短检查，确认开发板能点中位置、输入文字。检查期间请不要触碰屏幕；旋转设备或重新连接后需再检查一次。"
          }
        }
      }
    },
    "bluetooth.verifyButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始检查"
          }
        }
      }
    },
    "bluetooth.verifyAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        }
      }
    },
    "bluetooth.readyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready. Return to chat and describe your task. AI control can be turned off on the Device page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已就绪，回到对话说出你的任务即可。只想聊天时，可在设备页关闭 AI 操作。"
          }
        }
      }
    },
    "bluetooth.verifying": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking clicks and text input…\nPlease leave the screen untouched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查点击和文字输入…\n请不要触碰屏幕。"
          }
        }
      }
    },
    "bluetooth.keyboardCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking text input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查文字输入"
          }
        }
      }
    },
    "bluetooth.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "bluetooth.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "bluetooth.validationPassed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device control is ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备操作已就绪"
          }
        }
      }
    },
    "bluetooth.validationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check did not finish. Keep AssistiveTouch on and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查未完成。请保持辅助触控开启，再试一次。"
          }
        }
      }
    },
    "bluetooth.validationInterrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this page open and keep the device in the same orientation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持此页面打开，不要旋转设备。"
          }
        }
      }
    },
    "bluetooth.keyboardFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text input was not received. Check the selected keyboard connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未收到文字输入，请检查所选的键鼠连接方式。"
          }
        }
      }
    },
    "bluetooth.stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device connection or screen sharing ended. The task has stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备连接或屏幕共享已结束，任务已停止。"
          }
        }
      }
    },
    "bluetooth.inputRoute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方式"
          }
        }
      }
    },
    "bluetooth.inputBluetooth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙输入"
          }
        }
      }
    },
    "bluetooth.inputUSB": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB input"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 输入"
          }
        }
      }
    },
    "bluetooth.usbPowerDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the S3 USB/OTG port to this phone; COM/UART is for a computer. Lightning requires a USB camera/host adapter with power. An ordinary Lightning to USB-C cable cannot provide USB input. Commands still use Bluetooth."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "S3 的 USB／OTG 口接这台手机；COM／UART 口用于电脑。Lightning 手机需要带 USB 插口的相机／主机转接器，并给转接器供电。普通 Lightning 转 USB-C 线无法提供 USB 输入。指令仍通过蓝牙传输。"
          }
        }
      }
    },
    "bluetooth.outputChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input connection changed. Reconnect the board and run the check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入方式已切换，请重新连接开发板并完成操作检查。"
          }
        }
      }
    },
    "bluetooth.firstS3Connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the first connection to an S3 board, restart its power and connect within one minute. Eiscue saves the board connection securely; no configuration file is needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "S3 首次连接时，请给开发板重新通电，并在一分钟内连接。Eiscue 会安全保存连接信息，无需导入配置文件。"
          }
        }
      }
    },
    "bluetooth.usbTouchMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check incomplete: this phone received no click. Connect the board’s native USB/OTG port to this phone, not a computer. UART/COM is for the computer. Power the adapter and keep AssistiveTouch enabled, then reconnect and check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查未完成：本机没有收到点击。请把开发板的原生 USB／OTG 口接到这台 iPhone，别接电脑；UART／COM 口用于电脑。给转接器接电源并保持辅助触控开启，再重新连接和检查。"
          }
        }
      }
    },
    "bluetooth.waitingForUSB": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the phone to recognize USB…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待手机识别 USB…"
          }
        }
      }
    },
    "bluetooth.usbConfirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is USB connected to this phone?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 接的是这台手机吗？"
          }
        }
      }
    },
    "bluetooth.usbConfirmDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check sends keyboard and mouse input. Connect the board’s USB/OTG port only to this iPhone or iPad. COM/UART may connect to a computer for power. USB recognition alone does not identify which device is connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查会发送键鼠输入。请确认开发板的 USB／OTG 口只接这台 iPhone 或 iPad，COM／UART 口可接电脑供电。检测到 USB 连接不能判断接的是哪台设备。"
          }
        }
      }
    },
    "bluetooth.usbConfirmButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to this phone; start check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接这台手机，开始检查"
          }
        }
      }
    },
    "bluetooth.companionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board shows Eiscue’s expressions and progress. Press OK to stop; release it, then hold OK to unlock and reconnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发板会显示 Eiscue 表情和进展。按 OK 停止；松开后长按 OK 恢复，再重新连接。"
          }
        }
      }
    },
    "bluetooth.hardwareStopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped with the board button. Release OK, then hold it for 1.5 seconds to unlock. Reconnect and complete the device check before another device task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过开发板按键停止。松开 OK，再长按 1.5 秒解锁；重新连接并完成操作检查后再开始设备任务。"
          }
        }
      }
    },
    "bluetooth.hardwareStoppedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped with board button"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过开发板停止"
          }
        }
      }
    },
    "bluetooth.validationTouchTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking taps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查点击"
          }
        }
      }
    },
    "bluetooth.validationInputTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking typing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查输入"
          }
        }
      }
    },
    "bluetooth.validationProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device check progress"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备检查进度"
          }
        }
      }
    },
    "bluetooth.validationCompleteTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to go"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查完成"
          }
        }
      }
    },
    "bluetooth.validationFailedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check not completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查未完成"
          }
        }
      }
    }
  },
  "version": "1.0"
}
